# Dev control plane only. One project for iOS, website content and users. Supply its publishable keys.
FOIR_API_URL=https://rpc.foir.io
FOIR_PROJECT_ID=
FOIR_TENANT_ID=
TILLY_SITE_URL=https://your-site.example
# Optional email support/Reply-To address; keep account-specific values local.
TILLY_SUPPORT_EMAIL=
TILLY_APP_KEY=
# Native RevenueCat PUBLIC SDK key only. Subscriber verification uses the
# installed app’s revenueCatApiKey credential in Fóir, never a Worker binding.
TILLY_REVENUECAT_KEY=
VITE_PLATFORM_API_URL=https://api.foir.dev/graphql
# The website key belongs to FOIR_PROJECT_ID above. Its anonymous baseline is read-only;
# signed-in users can invoke only the approved operation ceiling.
VITE_PLATFORM_API_KEY=
# Copy your project’s scope URL from the dev console, without a trailing path.
VITE_FOIR_CONSOLE_URL=https://app.foir.io/t/your-workspace/p/your-project

# Hosted login shares the website's registrable domain and Fóir user pool.
# Enabling TILLY_LOGIN_ORIGIN declares the first-party auth client with the website ceiling.
# Review its grants before push, complete Fóir's DNS challenge, then set VITE too.
TILLY_LOGIN_ORIGIN=
VITE_FOIR_LOGIN_ORIGIN=
VITE_FOIR_AUTH_CLIENT_ID=tilly-web

# Separate CMS-only preview build; keep disabled on the public website. It uses
# the website key and reads drafts as the signed-in editor (docs/web-preview.md).
VITE_FOIR_PREVIEW=false
TILLY_PREVIEW_ORIGIN=
# Enable only after installed billing grants/configuration and test-mode checks.
VITE_TILLY_WEB_BILLING=false
# Label an intentionally isolated Stripe test deployment. Never use with live keys.
VITE_TILLY_WEB_BILLING_SANDBOX=false

# Keep a fresh installation closed until its policies and account flows are reviewed.
TILLY_PUBLIC_SIGNUP=false

# Match the hosted client slug in this target’s own project.
TILLY_WEB_CLIENT_ID=tilly-web
TILLY_PREVIEW_CLIENT_ID=tilly-preview
# Set false for isolated capture/social testing without paid execution grants.
TILLY_PAID_FEATURES_ENABLED=false

# Enable only after the content-safety scope and publication checks pass.
VITE_TILLY_MODERATION=false
# Server-only Worker switch. Store moderationOpenAI in the existing Tilly install’s Fóir credentials.
TILLY_MODERATION_ENABLED=false
# Provider credentials live only in Fóir; see docs/content-safety.md.
