{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilly",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/operations/*",
      "/_foir/apps/tilly/admin",
      "/_foir/apps/tilly.json",
      "/inbound/*",
    ],
  },
  "vars": {
    "TILLY_CANONICAL_ORIGIN": "",
    "FOIR_PROJECT_ID": "",
    "FOIR_TENANT_ID": "",
    "TILLY_NOTIFICATIONS_ENABLED": "false",
    "TILLY_MODERATION_ENABLED": "false",
    "LIVE": "false",
    "FOIR_PREVIEW": "false",
    "TILLY_PREVIEW_HOST": "",
    "TILLY_PREVIEW_LOGIN_ORIGIN": "",
    "TILLY_PREVIEW_AUTH_CLIENT_ID": "tilly-preview",
    "FOIR_API_ORIGIN": "https://api.foir.dev",
    "FOIR_FILES_ORIGIN": "https://cdn.foir.dev",
  },
  "env": {
    "preview": {
      "name": "tilly-preview",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "vars": {
        "TILLY_CANONICAL_ORIGIN": "",
        "FOIR_PROJECT_ID": "",
        "FOIR_TENANT_ID": "",
        "TILLY_NOTIFICATIONS_ENABLED": "false",
        "TILLY_MODERATION_ENABLED": "false",
            "LIVE": "false",
        "FOIR_PREVIEW": "true",
        "TILLY_PREVIEW_HOST": "",
        "TILLY_PREVIEW_LOGIN_ORIGIN": "",
        "TILLY_PREVIEW_AUTH_CLIENT_ID": "tilly-preview",
        "FOIR_API_ORIGIN": "https://api.foir.dev",
        "FOIR_FILES_ORIGIN": "https://cdn.foir.dev",
      },
    },
  },
}
