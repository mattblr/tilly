"""
The calling credential. Never any secret material: no key hash, no token bytes, no signing key id, no signature.
"""
type WhoamiCredential {
  """
  True by construction: the platform refuses a revoked or expired credential, so reaching this field is the proof.
  """
  active: Boolean!

  """
  The key's per-model confinement. Where the key does not reach every model the allowedModels narrowing applied, and an empty list then means it reaches no model's records.
  """
  allowedModels: [String!]

  """"""
  app: String

  """"""
  expiresAt: String

  """
  What a scoped token carries, as grants in the permission catalogue's names.
  """
  grants: [String!]

  """
  The api_keys row id, the scoped token's jti, or user:<userId>. Not a secret — it is what support needs to find the credential.
  """
  id: String

  """"""
  issuedAt: String

  """"""
  issuer: String

  """
  The prefix a key of this kind is minted with ("foir_pub_", "foir_srv_" or "foir_adm_"), said from the key's kind. The presented string is never read here.
  """
  keyPrefix: String

  """"""
  keyType: String

  """"apiKey", "scopedToken" or "consoleToken"."""
  kind: String!

  """"""
  modelConfinement: WhoamiModelConfinement

  """"""
  notBefore: String

  """"""
  projectId: String!

  """"""
  rateLimitPerHour: Int

  """"""
  tenantId: String!

  """"""
  user: WhoamiUser
}

