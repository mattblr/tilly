"""
Progress/terminal event for a Preview active challenge invitation audience execution with a typed result.
"""
type ChallengeAnnouncementsPreviewExecutionUpdate {
  """Present on status=failed|timed_out"""
  errorJson: JSON

  """"""
  id: String!

  """"""
  progressMessage: String

  """"""
  progressMetadata: JSON

  """0-100; null on terminal events"""
  progressPct: Int

  """RFC3339; present on progress events"""
  progressUpdatedAt: String

  """Typed result payload; present on status=completed"""
  result: ChallengeAnnouncementsPreviewOutput

  """pending|dispatched|running|completed|failed|cancelled|timed_out"""
  status: String!
}

