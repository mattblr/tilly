"""Cursor-page metadata. Relay-compliant."""
type PageInfo {
  """Cursor for the last row in this page; null when the page is empty."""
  endCursor: String

  """
  True when a forward fetch (after the current page's end) would yield more rows.
  """
  hasNextPage: Boolean!

  """
  True when a backward fetch (before the current page's start) would yield more rows.
  """
  hasPreviousPage: Boolean!

  """Cursor for the first row in this page; null when the page is empty."""
  startCursor: String
}

