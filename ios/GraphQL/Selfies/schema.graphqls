"""
Real-time record change notification, projected from the durable event log.
"""
type RecordChangedEvent {
  """created, updated, published, unpublished, or deleted"""
  action: String!

  """
  Event family name, e.g. RECORD_UPDATED. The same name a hook subscribes to.
  """
  event: String

  """
  Id of the durable event this message projects. The same id a webhook delivery for this change carries.
  """
  eventId: String

  """"""
  modelKey: String!

  """"""
  recordId: ID!

  """
  Platform sequence, assigned in commit order and monotonic per project. Apply last-write-wins: keep the highest seq you have applied per record and discard anything at or below it.
  """
  seq: Float

  """
  Actor who made the change, when a user made it. Absent for system, service and scoped callers.
  """
  userId: String
}

