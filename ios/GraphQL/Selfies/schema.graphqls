  requestPasswordReset(email: String!, clientId: String): Boolean!

  """
  Take back an app's authority to act for the signed-in user. Its tokens for them stop working at once, and it has to ask them again.
  """
  revokeAuthorizedApp(
    """The id myAuthorizedApps gave the app"""
    id: String!
  ): Boolean!

  """"""
  sendBulkNotifications(input: SendBulkNotificationsInput!): Boolean!

  """"""
  sendNotification(input: SendNotificationInput!): Boolean!

  """
  Set how a file is served. PUBLIC keeps a direct, CDN-cacheable URL; PRIVATE requires a signed access token.
  """
  setFileVisibility(
    """The visibility to apply."""
    visibility: Visibility!

    """The id of the file whose visibility to set."""
    id: ID!
  ): Visibility!

  """"""
  signInWithProvider(input: ProviderSignInInput!): ProviderSignInResponse

  """"""
  signOut: Boolean!

  """
  Sign the signed-in user out of every session and every app, and answer how many sessions ended. Their personal access tokens stay.
  """
  signOutEverywhere(
    """Keep the session making this request"""
    keepThis: Boolean
  ): Int!

  """
  Begin proving the signed-in user's session again, on the hosted step-up page: their password, and their second factor where they hold one. The proof pays for one change to their factors in the next ten minutes; a second factor also lifts the session to two factors.
  """
  stepUp: AuthStepUp!

  """"""
  unregisterDeviceToken(token: String!): Boolean!

  """"""
  updateFile(altText: String, caption: String, description: String, id: ID!, filename: String, folder: String, tags: [String!]): File

  """
  Update the signed-in user's own name, picture and language. It asks no permission: these are the person's own.
  """
  updateMyProfile(
    """Given name. An empty string clears it."""
    firstName: String

    """Family name. An empty string clears it."""
    lastName: String

    """Address of their picture. An empty string clears it."""
    avatarUrl: String

    """
    Language to read in, as a BCP47 tag. Pass an empty string to clear the choice and follow the project default. Must be a locale the project publishes.
    """
    preferredLocale: String
  ): AuthUserProfile

  """"""
  updateNotificationPreference(input: UpdateNotificationPreferenceInput!): Boolean!

  """"""
  updatePassword(currentPassword: String!, newPassword: String!): Boolean!

  """"""
  uploadFile(
    """"""
    mimeType: String!

    """"""
    size: Int!

    """"""
    folder: String

    """"""
    metadata: JSON

    """
    How the finished file is served. Omit to take the default, which is PRIVATE for a file a user owns and PUBLIC for a file no user owns, such as an organization's.
    """
    visibility: Visibility

    """"""
    filename: String!
  ): FileUpload
}

