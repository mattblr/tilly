  """
  Join the project's sign-up waitlist (the project must be in waitlist mode). True for every address.
  """
  joinWaitlist(email: String!): Boolean!

  """
  End your own membership where this request stands: the organization it stands in, or, standing in none, the project's own. Every role you hold there ends with it, and your account and everything you made stay. False when you held no membership there. Refused where it would leave an organization with nobody who can staff it, or leave you nowhere to sign in: you keep one membership in the project, and deleting your account is how you leave altogether.
  """
  leaveMembership: Boolean!

  """
