type Mutation {
  """
  Accept an invitation (pre-auth). Always issues access + refresh tokens. If password is supplied AND the project has password auth enabled, the platform sets it as the user's credential in the same step.
  """
  acceptInvitation(input: AcceptAuthInvitationInput!): AuthInvitationAcceptPayload!

  """
  Send a code to an address the signed-in user is adding to their account, and answer the step to post it to, within ten minutes. The address is kept once the code comes back on the step, from a session that is still live. Asks for their current password; an account with none asks for a sign-in in the last ten minutes. At most five codes an hour.
  """
  addMyAddress(
    """"""
    email: String!

    """The account's current password, when it holds one"""
    password: String
  ): AccountStep!

  """
  Begin adding an authenticator app, a security key or a passkey, spending the session's step-up proof. What the authenticator makes is posted to the answer's step, within ten minutes, from a session that is still live.
  """
  beginFactorEnrollment(
    """
    totp for an authenticator app, webauthn for a security key held as a second factor, passkey for a passkey that signs the user in on its own
    """
    method: String!
  ): AuthFactorEnrollment!

  """
  Start connecting one of the project's providers to the signed-in user's account, and answer the provider's address for the browser to go to. The browser comes back to returnTo with connected naming the provider, or connect_error naming why it was refused.
