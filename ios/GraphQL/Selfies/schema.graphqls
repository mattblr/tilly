  connectSignInMethod(
    """
    The app's page to come back to, beneath the app address the project or the user's organisation set
    """
    returnTo: String!

    """"""
    provider: String!
  ): String!

  """
  Make a personal access token for the signed-in user: a standing credential they present beside the app's key, as Authorization: Bearer. It carries what their roles give them where it is used, and lasts until it expires or is revoked with endMySession.
