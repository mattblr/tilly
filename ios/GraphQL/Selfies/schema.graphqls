  execution: OperationExecution!

  """
  True when concurrencyKey matched a run in flight, so this call joined it and the operation was not started again.
  """
  joined: Boolean!

  """
  True when idempotencyKey matched an execution in flight or completed, so this call adopted it and the operation did not run again.
  """
  replayed: Boolean!

  """Typed result; populated on SYNC completion, null on ASYNC dispatch."""
  result: TillyPostMyCatchesOutput

  """
  Set when idempotencyKey's last execution had failed, timed out or been cancelled: that execution's id. A failure is not adopted, so this call started a new execution instead.
  """
  supersededExecutionId: String
}

