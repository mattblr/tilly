""""""
type Subscription {
  """
  Stream this project's durable event log, resumably. Connect via WebSocket at /graphql/ws. The project team's surface: requires events:read on an admin key. Pass the highest `seq` you have processed as `after` and you receive everything you missed, in seq order, then continue live — one stream, so nothing is delivered twice and nothing falls between history and live. Serves the same flat 90-day window as the events query; a cursor older than that ends the subscription with code cursor_expired and the seq to resume from, rather than silently skipping.
  """
  events(
    """
    Optional filter on event name, e.g. ["RECORD_CREATED", "RECORD_UPDATED"]. SCREAMING_SNAKE, the same wording the events query uses: a name in any other casing matches nothing and the stream simply stays silent, which is indistinguishable from an idle project.
    """
    events: [String!]

    """
    Exclusive cursor: start with events whose seq is greater than this. Omit or pass 0 to start at the oldest event inside the retention window.
    """
    after: EventSeq
  ): Event!

  """
  Subscribe to background-job lifecycle events for your tenant/project. Connect via WebSocket at /graphql/ws.
  """
  jobProgress: JobProgressEvent!

  """
  Subscribe to your own real-time notifications. Scoped server-side to the connection's user — no arguments. Connect via WebSocket at /graphql/ws.
  """
  notification: NotificationEvent!

  """
  Subscribe to progress and terminal events for a single Announce newly active photo challenges execution. Connect via WebSocket at /graphql/ws.
  """
  operationChallengeAnnouncementsExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): ChallengeAnnouncementsExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Preview active challenge invitation audience execution. Connect via WebSocket at /graphql/ws.
  """
  operationChallengeAnnouncementsPreviewExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): ChallengeAnnouncementsPreviewExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single operation execution. Connect via WebSocket at /graphql/ws.
  """
  operationExecution(
    """Execution id (returned by executeXxx, or by StartRun)."""
    id: String!
  ): OperationExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Send an opted-in community notification execution. Connect via WebSocket at /graphql/ws.
  """
  operationNotificationCampaignExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): NotificationCampaignExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Review reported or flagged content execution. Connect via WebSocket at /graphql/ws.
  """
  operationReviewContentExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): ReviewContentExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Notify a social activity recipient execution. Connect via WebSocket at /graphql/ws.
  """
  operationSocialNotificationExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): SocialNotificationExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Remind opted-in active streaks execution. Connect via WebSocket at /graphql/ws.
  """
  operationStreakRemindersExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): StreakRemindersExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Tidy my followers execution. Connect via WebSocket at /graphql/ws.
  """
  operationTidyFollowersExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TidyFollowersExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Check a saved catch execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyCheckCaptureExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyCheckCaptureExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Evaluate photo challenges execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyEvaluateChallengesExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyEvaluateChallengesExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Make catch art execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyMakeCatchArtExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyMakeCatchArtExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Repair who sees my catches execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyPostMyCatchesExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyPostMyCatchesExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Try an art style execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyPreviewArtExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyPreviewArtExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Reconcile RevenueCat subscriptions execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyReconcileRevenuecatExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyReconcileRevenuecatExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Reconcile Stripe subscription execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyReconcileStripeExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyReconcileStripeExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Save a catch execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillySaveCatchExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillySaveCatchExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Save my profile execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillySaveProfileExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillySaveProfileExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Share a capture execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillyShareCaptureExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillyShareCaptureExecutionUpdate!

  """
  Subscribe to progress and terminal events for a single Suggest a captured cat’s appearance execution. Connect via WebSocket at /graphql/ws.
  """
  operationTillySuggestCatAppearanceExecution(
    """
    Execution id (returned by executeXxx, or by StartRun when the run is queued).
    """
    id: String!
  ): TillySuggestCatAppearanceExecutionUpdate!

  """
  Subscribe to real-time record changes for a model. Connect via WebSocket at /graphql/ws using the graphql-ws protocol. Pass the highest `seq` you have applied as `after` and you receive every change you missed from the durable log first, in seq order, then continue live — so a message lost in transit is repaired by the next connect rather than left as a permanently stale cache entry.
  """
  recordChanged(
    """The model key to watch for changes"""
    modelKey: String!

    """
    Exclusive resume cursor: replay changes to this model whose seq is greater than this, then continue live. Omit (or pass 0) for the live stream only. A cursor further behind than this surface will page ends the subscription with code backlog_too_large; one older than the 90-day retention window ends it with cursor_expired. Both are refusals to handle — refetch, then resubscribe from the seq that read reports — never a silent partial replay.
    """
    after: EventSeq
  ): RecordChangedEvent!
}

