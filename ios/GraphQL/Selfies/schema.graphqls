"""
Controls response-cache behaviour for the annotated field. See response-cache-rfc.md.
"""
directive @cacheControl(
  """
  Maximum cache lifetime in seconds. The resolved request TTL is the minimum across all selected fields.
  """
  maxAge: Int = 60

  """Caller-scope handling for the cached entry."""
  scope: CacheControlScope
) on FIELD_DEFINITION | OBJECT | INTERFACE | UNION | QUERY

