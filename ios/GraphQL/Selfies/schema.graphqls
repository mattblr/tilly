}

""""""
type Image {
  """
  This value's own id when it is an entry of a prose field, an item of a list or an embedded model instance: minted when it is made, never changed, and unique within its record. It is not a record id. Null on a value that is none of these, such as a plain image field's.
  """
  _id: String

  """"""
  alt: String

  """
  AVIF tier set (smaller; narrower support). Preferred <picture> source, with `webp` as the fallback.
  """
  avif: ImageVariantSet

  """"""
  blurhash: String

  """"""
  crop: JSON

  """"""
  dominantColor: String

  """"""
  fileSize: Int

  """"""
  focalPoint: JSON

  """"""
  height: Int

  """"""
  mimeType: String

  """"""
  url: String

  """"""
  variants(
    """
    Output format for the tier set (default WEBP). Prefer the dedicated `webp`/`avif` fields to drive a <picture> in one query; kept for back-compat and for requesting JPEG/PNG.
    """
    format: ImageFormat
  ): ImageVariantSet

  """WebP tier set (universal support). Pair with `avif` in a <picture>."""
  webp: ImageVariantSet

  """"""
  width: Int
}

