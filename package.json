{
  "name": "tilly",
  "private": true,
  "type": "module",
  "scripts": {
    "configure:operations": "node --env-file-if-exists=.env --import tsx scripts/configure-installed-operations.mts",
    "build": "pnpm check:config && pnpm --dir web build",
    "test": "node --import tsx --test web/src/server/*.test.mjs web/src/server/operations/*.test.mjs web/src/server/payments/*.test.ts web/src/lib/*.test.ts web/src/components/*.test.ts web/src/features/app/*.test.ts scripts/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:ios-pagination": "node scripts/check-native-pagination.mjs",
    "check:ios-contract": "node scripts/check-native-contract.mjs",
    "check:ios-session": "node scripts/check-native-session.mjs",
    "seed": "node scripts/seed.mjs",
    "check:config": "tsc --noEmit --skipLibCheck --allowImportingTsExtensions --module esnext --moduleResolution bundler --target es2022 --resolveJsonModule --allowSyntheticDefaultImports foir.config.ts",
    "check:web": "node scripts/check-web.mjs",
    "deploy": "pnpm build && pnpm --dir web deploy",
    "generate:website": "node scripts/generate-website.mjs",
    "dev": "pnpm --dir web dev",
    "check:ios-streak": "node scripts/check-native-streak.mjs",
    "check:ios-theme": "node scripts/check-native-theme.mjs",
    "check:ios-errors": "node scripts/check-native-errors.mjs",
    "check:ios-appearance": "node scripts/check-native-appearance.mjs",
    "check:ios-inbox": "node scripts/check-native-inbox.mjs",
    "check:ios-subscription": "node scripts/check-native-subscription.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vite": "7.3.7",
    "wrangler": "4.156.0",
    "@foir/cli": "0.89.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.13"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0"
}
